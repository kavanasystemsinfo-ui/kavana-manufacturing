# =============================================================================
# Variables del stack local (docker compose). Copiar a .env y rellenar.
#
#   cp .env.example .env
#
# .env está en .gitignore: no se commitea. Este fichero sí, para que quede
# documentado qué variables existen.
# =============================================================================

# --- Puertos publicados al host ---------------------------------------------
# Los valores por defecto son los que usa el compose si no defines nada, pero
# en una máquina compartida suelen estar ocupados. En el VPS de Kavana:
#   - 5433 lo tiene mekania-postgres
#   - 80 lo tiene el nginx del host, que sirve las landings
# Si arrancas con el puerto ocupado, docker responde
# "Bind for 0.0.0.0:XXXX failed: port is already allocated" y el contenedor
# ni siquiera se crea. Solución: cambiar el puerto aquí.
DB_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=80

# --- Postgres -----------------------------------------------------------------
# Contraseña del usuario `kavana` dentro del contenedor de desarrollo.
DB_PASSWORD=kavana_v3_password

# --- Redis --------------------------------------------------------------------
# OBLIGATORIA: el compose falla al arrancar si no está definida
# ("error while interpolating services.redis... REDIS_PASSWORD is missing").
# Redis no publica puerto al host y solo es accesible por la red interna de
# compose. Rellena con una cadena propia, no dejes el ejemplo.
REDIS_PASSWORD=cambia-esto

# --- Autenticación del backend ------------------------------------------------
# En desarrollo sirven los valores por defecto del compose. En producción son
# obligatorias y distintas de estos ejemplos.
JWT_SECRET=dev-secret-change-in-production
JWT_HMAC_SECRET=kavana-hmac-dev-only
# true solo en desarrollo local; en producción el backend lo ignora.
ALLOW_MOCK_AUTH=false

# --- Proveedores LLM (asistente IA del panel) ---------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
