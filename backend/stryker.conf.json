{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutator": "typescript",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "off",
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/main.ts",
    "!src/ai-advisor/**"
  ],
  "files": [
    "src/**/*.ts",
    "!src/ai-advisor/**",
    "vitest.config.ts",
    "tsconfig.json",
    "package.json"
  ],
  "timeoutFactor": 2,
  "timeoutMS": 60000,
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}