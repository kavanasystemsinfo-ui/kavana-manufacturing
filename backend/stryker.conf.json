{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "json", "clear-text", "progress"],
  "coverageAnalysis": "off",
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/main.ts",
    "!src/ai-advisor/**",
    "!src/auth-login/auth-login-puesto.spec.ts"
  ],
  "files": [
    "src/**/*.ts",
    "!src/ai-advisor/**",
    "vitest.config.ts",
    "tsconfig.json",
    "package.json",
    "database/migrations/**/*.sql",
    "database/seed.sql"
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".stryker-tmp/**"
  ],
  "timeoutFactor": 2,
  "timeoutMS": 60000,
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}