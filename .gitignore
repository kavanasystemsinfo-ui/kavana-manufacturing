node_modules/
dist/
build/
.env
.env.*
!.env.example
coverage/
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
backend/test-keys/
__pycache__/
*.pyc

# NotebookLM automation outputs must never become NotebookLM sources again.
# These paths are ignored by Git; Google Drive Desktop must also exclude them
# if it is configured to sync the whole repository or Desktop.
tools-ai/notebooklm/outputs/
tools-ai/notebooklm/.venv/
tools-ai/notebooklm/chrome_profile/
docs/ai/outputs/*.md
docs/ai/outputs/*.json
!docs/ai/outputs/README.md
!docs/ai/outputs/.gitkeep

# Graphify
graphify-out/cost.json
graphify-out/cache/

# Temp scripts
backend/*.cjs
backend/*.mjs
.graphifyignore

# Artefactos de Playwright: se regeneran en cada ejecución del E2E y no son
# fuente de nada. Estaban versionados, así que cada corrida dejaba el árbol sucio.
frontend/playwright-report/
frontend/test-results/

# Sandboxes de Stryker: se regeneran en cada ejecucion de mutation testing
# (35 MB la ultima vez). Ignorarlos mantiene el arbol limpio tras stryker run.
backend/.stryker-tmp/
